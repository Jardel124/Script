function createToggle(configs)
	local Infos = {
		Text = configs.Text or "Toggle",
		Index = configs.Index,
		Callback = configs.Callback or function() end
	}

	if Infos.Index == nil then
		Infos.Index = #Scroller:GetChildren() + 1
	end

	local Value = Instance.new("BoolValue")
	Value.Name = Infos.Text .. "Value"
	Value.Value = false

	local Toggle = Instance.new("TextButton", Scroller)
	Toggle.Size = UDim2.new(1, 0, 0, 50)
	Toggle.LayoutOrder = Infos.Index
	Toggle.BackgroundTransparency = .8
	Toggle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	Toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
	Toggle.TextStrokeTransparency = 0
	Toggle.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	Toggle.TextScaled = true

	local UICorner = Instance.new("UICorner", Toggle)
	UICorner.CornerRadius = UDim.new(.1, 0)

	local UIStroke = Instance.new("UIStroke", Toggle)
	UIStroke.Thickness = 2
	UIStroke.Color = Color3.fromRGB(255, 255, 255)

	local function Update()
		if Value.Value then
			Toggle.Text = Infos.Text .. ": ON"
			Toggle.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
		else
			Toggle.Text = Infos.Text .. ": OFF"
			Toggle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		end
	end

	Value.Changed:Connect(function(NewValue)
		Update()
		Infos.Callback(NewValue)
	end)

	Toggle.MouseButton1Click:Connect(function()
		Value.Value = not Value.Value
	end)

	Update()

	return Toggle, Value :: BoolValue
end

